# ==========================================
# Frame - Configuration d'environnement
# ==========================================

# Port d'écoute du serveur (par défaut: 30017)
PORT=30017

# Environnement (production / development)
NODE_ENV=production

# Sécurité & Sessions (Générez une chaîne aléatoire longue pour la production)
JWT_SECRET=votre_cle_secrete_jwt_a_remplacer_ici

# Dossiers de données et de configuration (dans le conteneur ou en local)
DATA_DIR=./data
CONFIG_DIR=./config

# Langue par défaut pour les métadonnées (fr-FR recommandé)
DEFAULT_LANGUAGE=fr-FR

# ------------------------------------------
# Intégration The Movie Database (TMDB)
# https://www.themoviedb.org/settings/api
# ------------------------------------------
TMDB_API_KEY=

# ------------------------------------------
# Intégration Overseerr / Jellyseerr ("Seer")
# ------------------------------------------
SEER_URL=http://serveur:5055
SEER_API_KEY=

# ------------------------------------------
# Intégration Sonarr (Séries TV)
# ------------------------------------------
SONARR_URL=http://serveur:8989
SONARR_API_KEY=

# ------------------------------------------
# Intégration Radarr (Films)
# ------------------------------------------
RADARR_URL=http://serveur:7878
RADARR_API_KEY=

# ------------------------------------------
# Intégration Simkl (Suivi des vues)
# https://simkl.com/settings/developer/
# ------------------------------------------
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
SIMKL_ACCESS_TOKEN=
