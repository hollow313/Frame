# ==========================================
# Frame - Configuration d'environnement
# ==========================================

# Port d'écoute du serveur (par défaut: 30018)
PORT=30018

# Environnement (production / development)
NODE_ENV=production

# Sécurité & Sessions (Généré automatiquement de manière aléatoire au 1er démarrage si laissé vide)
JWT_SECRET=

# Chiffrement optionnel AES-256-GCM des clés d'API et tokens stockés dans SQLite (F-10)
FRAME_ENCRYPTION_KEY=

# Origines CORS autorisées séparées par des virgules (ex: https://frame.mondomaine.fr) - F-06
CORS_ORIGINS=

# Activer l'attribut Secure sur le cookie de session (mettre false si accès en HTTP local sans HTTPS) - F-06
COOKIE_SECURE=false

# Proxies de confiance autorisés à injecter l'en-tête SSO Remote-User (CIDR séparés par des virgules) - F-07
SSO_TRUSTED_PROXIES=

# Liste blanche d'hôtes internes autorisés pour Jellyfin / Seer / Sonarr / Radarr (protection SSRF) - F-02
INTERNAL_HOSTS_ALLOWLIST=

# Dossiers de données et de configuration (dans le conteneur ou en local)
DATA_DIR=./data
CONFIG_DIR=./config

# Langue par défaut pour les métadonnées (fr-FR recommandé)
DEFAULT_LANGUAGE=fr-FR

# ------------------------------------------
# Intégration The Movie Database (TMDB)
# https://www.themoviedb.org/settings/api
# ------------------------------------------
TMDB_API_KEY=

# ------------------------------------------
# Intégration Overseerr / Jellyseerr ("Seer")
# ------------------------------------------
SEER_URL=http://serveur:5055
SEER_API_KEY=

# ------------------------------------------
# Intégration Sonarr (Séries TV)
# ------------------------------------------
SONARR_URL=http://serveur:8989
SONARR_API_KEY=

# ------------------------------------------
# Intégration Radarr (Films)
# ------------------------------------------
RADARR_URL=http://serveur:7878
RADARR_API_KEY=

# ------------------------------------------
# Intégration Simkl (Suivi des vues)
# https://simkl.com/settings/developer/
# ------------------------------------------
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
SIMKL_ACCESS_TOKEN=
